<mxCell id="n1" value="&lt;b&gt;CDKToolkit ROLLBACK_COMPLETE&lt;/b&gt; → iam:CreateRole 권한&lt;br&gt;&lt;b&gt;Missing required context values&lt;/b&gt; → -c 네 개 전달 (4장)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="380" y="251" width="660" height="96" as="geometry" /></mxCell>
